        //#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define RAIZE2   5
#define HIGHER   6
#define SCROLL   2

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_BSLH  INT1         // (backslash)

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 120


&trackball_listener {
    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
        &zip_temp_layer MOUSE 700
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
            &zip_xy_scaler 1 20
            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        jp2: jp2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        
        jp6: jp6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jp7: jp7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp AMPS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jp8: jp8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp ASTRK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jp9: jp9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LPAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moA: moA {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moB: moB {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp MINUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moC: moC {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT3>, <&kp JP_PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moD: moD {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LBRC>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moE: moE {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp RBRC>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moF: moF {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp KP_PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moG: moG {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp APOSTROPHE>, <&kp DQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moH: moH {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp TILDE2>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moI: moI {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_BSLH>, <&kp JP_UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
        shift_to0_grave: shift_to0_grave {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&to0_and_grave>;
        };
    };
};


&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };
          // ★追加
                to0_and_grave: to0_and_grave {
                    compatible = "zmk,behavior-macro";
                    #binding-cells = <0>;

                    bindings =
                        <&to 0>,
                        <&kp GRAVE>;
    
                    label = "TO0_AND_GRAVE";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC    &kp N1      &jp2    &kp N3        &kp N4          &kp N5                                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                                        &jp6                      &jp7    &jp8       &jp9     &moB           &kp DEL
&kp DEL    &kp Q       &kp W   &kp E         &kp R           &kp T                                   &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                                      &kp Y                     &kp U   &kp I      &kp O    &kp P          &lt 6 JP_AT
&kp TAB    &kp A       &kp S   &kp D         &kp F           &kp G      &mt INS JP_CARET             &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp JP_TILDE                      &kp H                     &kp J   &kp K      &kp L    &mt RALT SEMI  &mt RCTRL JP_COLON
&kp LSHFT  &kp Z       &kp X   &kp C         &kp V           &kp B      &mt LSHFT JP_LBRACKET        &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &mt RIGHT_SHIFT JP_RBRACKET       &kp N                     &kp M   &kp COMMA  &kp DOT  &kp FSLH       &lt 5 JP_YEN
&kp LCTRL  &kp C_MUTE  &mo 2   &mo 3  	     &kp SPACE       &lt 6 ENTER                                                                                                                       &mt RIGHT_SHIFT GRAVE     &kp BSPC                                   &lt 2 JP_UNDERSCORE
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC           &trans           &trans              &trans                  &trans             &trans                                   &trans  &trans  &trans  &trans                                     &trans                     &trans          &trans              &trans          &trans              &trans
&to_layer_0 DELETE        &to_layer_0 Q    &to_layer_0 W       &to_layer_0 E           &to_layer_0 R      &to_layer_0 T                            &trans  &trans  &trans  &trans                                     &to_layer_0 Y              &to_layer_0 U   &to_layer_0 I       &to_layer_0 O   &to_layer_0 P       &lt 6 JP_AT
&to_layer_0 TAB           &to_layer_0 A    &to_layer_0 S       &to_layer_0 D           &to_layer_0 F      &to_layer_0 G   &msc SCRL_DOWN           &trans  &trans  &trans  &trans    &msc SCRL_UP                     &to_layer_0 H              &mkp LCLK       &to_layer_0 K       &mkp RCLK       &mt RALT SEMI       &kp RIGHT_CONTROL
&trans                    &to_layer_0 Z    &to_layer_0 X       &to_layer_0 C           &to_layer_0 V      &to_layer_0 B   &mt LSHFT JP_LBRACKET    &trans  &trans  &trans  &trans    &mt RIGHT_SHIFT JP_RBRACKET      &to_layer_0 N              &to_layer_0 M   &mkp MB4           &mkp MB5        &to_layer_0 FSLH     &mo 5
&kp LEFT_CONTROL          &trans           &trans              &trans                  &trans             &trans                                                                                                      &shift_to0_grave LSHFT 0   &trans                                                                  &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
            bindings = <
&kp LG(LS(S))  &none      &none     &none     &none     &none                     &trans  &trans  &trans  &trans                      &none          &trans          &trans       &trans        &trans         &trans
&trans         &none      &none     &none     &kp UP    &none                     &trans  &trans  &trans  &trans                      &none          &none           &kp LEFT     &kp UP_ARROW  &kp RIGHT      &none
&mkp MB4       &mkp MB5   &none     &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_UP      &trans  &trans  &trans  &trans    &kp SPACE         &kp PG_UP      &mkp LCLK       &kp DOWN     &mkp RCLK     &kp RIGHT_ALT  &kp KP_ENTER
&trans         &none      &none     &kp END   &kp HOME  &none      &kp PAGE_DOWN  &trans  &trans  &trans  &trans    &kp RA(X)         &kp PAGE_DOWN  &kp END         &kp HOME     &none         &none          &none
&kp LA(F11)    &kp RSHFT            &trans    &trans    &trans     &trans                                                             &kp SPACE      &mkp LCLK                                                 &studio_unlock
            >;
        };

         raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&kp LG(LS(S))  &kp F1     &kp F2         &kp F3         &kp F4      &kp F5                          &trans  &trans  &trans  &trans                           &kp F6         &kp F7     &kp F8        &kp F9     &kp F10        &kp F11
&trans         &none      &kp N7         &kp N8         &kp N9      &kp KP_MINUS                    &trans  &trans  &trans  &trans                           &none          &kp LEFT   &kp UP_ARROW  &kp RIGHT  &none          &kp BACKSPACE
&trans         &kp SLASH  &kp N4         &kp N5         &kp N6      &kp JP_PLUS   &kp LGUI          &trans  &trans  &trans  &trans  &msc SCRL_UP           &kp PG_UP      &mkp LCLK  &kp DOWN      &mkp RCLK  &kp RIGHT_ALT  &kp KP_ENTER
&kp LSHFT      &kp N0     &kp N1         &kp N2         &kp N3      &kp JP_EQUAL  &kp JP_LPAREN     &trans  &trans  &trans  &trans    &kp JP_RPAREN          &kp PAGE_DOWN  &none      &none         &none      &none          &none
&kp LCTRL      &none      &kp KP_COMMA   &trans         &trans      &trans                                                                                   &kp SPACE      &mkp LCLK                                          &kp LG(E)
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE    &trans        &trans        &trans        &trans                                                              &trans          &kp DEL                     &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        raise2_layer {
            display-name = "RAIZE2";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC    &kp N1      &jp2    &kp N3        &kp N4          &kp N5                                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                                        &jp6          &jp7    &jp8       &jp9             &moB           &kp DEL
&kp DEL    &kp Q       &kp W   &kp E         &kp R           &kp T                                   &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                                      &kp Y         &kp U   &kp I      &kp O            &kp P          &kp JP_AT
&kp TAB    &kp A       &kp S   &kp D         &kp F           &kp G      &mt INS JP_CARET             &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp JP_TILDE                      &kp H         &kp J   &kp LEFT   &kp UP_ARROW     &kp RIGHT      &mt RCTRL JP_COLON
&kp LSHFT  &kp Z       &kp X   &kp C         &kp V           &kp B      &mt LSHFT JP_LBRACKET        &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &mt RIGHT_SHIFT JP_RBRACKET       &kp N         &kp M   &mkp LCLK  &kp DOWN         &mkp RCLK      &lt 5 JP_YEN
&kp LCTRL  &kp C_MUTE          &lt 2 LWIN    &mo 3  	     &kp SPACE  &lt 6 ENTER                                                                          &mt RIGHT_SHIFT GRAVE             &kp BSPC                                                         &lt 2 JP_UNDERSCORE
            >;
        };

        higher_layer {
            display-name = "HIGHER";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&none  &kp F1      &kp F2  &none   &none    &none               &trans  &trans  &trans  &trans                 &none           &none      &none      &none        &kp RC(W)  &kp RC(RA(DELETE))
&none  &kp F3      &kp F4  &kp F5  &kp F6   &none               &trans  &trans  &trans  &trans                 &none           &none      &kp TAB    &kp RS(TAB)  &none      &none
&none  &kp F7      &kp F8  &kp F9  &kp F10  &kp F11  &kp F12    &trans  &trans  &trans  &trans    &kp RC(F11)  &none           &kp RC(C)  &kp RC(X)  &kp RC(V)    &none      &kp RC(W)
&none  &none       &none   &none   &none    &none    &none      &trans  &trans  &trans  &trans    &kp RC(F11)  &none           &none      &none      &none        &none      &none
&none  &kp C_MUTE          &trans  &trans   &trans   &trans                                       &mkp LCLK    &mkp RCLK                                                     &trans
            >;
        };
    };
};
